# ── API ───────────────────────────────────────────────────────────────────────
# Local dev : http://localhost:8000/api/v1
# Production: https://your-app.up.railway.app/api/v1
VITE_API_URL=

# ── WhatsApp business number (digits only, no +) ──────────────────────────────
# e.g. 915468427200  (91 country code + 10-digit number)
VITE_WA_NUMBER=915468427200

# ── IMPORTANT ─────────────────────────────────────────────────────────────────
# Do NOT put any secret API keys here (OpenAI, Groq, etc.).
# VITE_* variables are embedded in the browser bundle and are publicly visible.
# All AI / payment calls must go through the backend.
