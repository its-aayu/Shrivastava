# ── Database ──────────────────────────────────────────────────────────────────
# Neon: postgresql+psycopg2://user:password@host/dbname?sslmode=require
# Local: postgresql+psycopg2://postgres:password@localhost:5432/aayu_printing
DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# ── Cloudinary (cloud file uploads) ───────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
# If not set, files are saved locally to backend/app/uploads/ (dev only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Observability (optional) ──────────────────────────────────────────────────
# Get from: https://sentry.io → Project → Settings → Client Keys (DSN)
# Leave empty to disable Sentry error tracking
SENTRY_DSN=

# ── App ───────────────────────────────────────────────────────────────────────
# Set DEBUG=false in production (Railway)
DEBUG=false
# Add your Vercel frontend URL here for production
ALLOWED_ORIGINS=https://shrivastava-five.vercel.app,http://localhost:5173,http://localhost:3000
